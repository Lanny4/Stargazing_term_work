<% content_for :title, "Адміністрування — Stargazing" %>
<section class="container section inner-page admin"><div class="eyebrow">КЕРУВАННЯ МАГАЗИНОМ STARGAZING</div><h1>Панель <em>адміністратора</em></h1>
<div class="stat-grid"><div class="stat-card"><strong><%= @products_count %></strong><span>Товарів</span></div><div class="stat-card"><strong><%= @users_count %></strong><span>Користувачів</span></div><div class="stat-card"><strong><%= @orders_count %></strong><span>Замовлень</span></div><div class="stat-card"><strong><%= @messages_count %></strong><span>Звернень</span></div></div>
<div class="admin-links"><%= link_to "Керування товарами", admin_products_path, class: "btn" %><%= link_to "Усі замовлення", admin_orders_path, class: "btn btn-outline" %><%= link_to "Повідомлення", admin_contact_messages_path, class: "btn btn-outline" %></div>
<h2>Останні замовлення</h2><div class="table-scroll"><table class="data-table"><thead><tr><th>Номер</th><th>Покупець</th><th>Сума</th><th>Статус</th></tr></thead><tbody><% @latest_orders.each do |order| %><tr><td><%= link_to "##{order.id}", admin_order_path(order) %></td><td><%= order.user.name %></td><td><%= money(order.total_cents) %></td><td><%= display_status(order.status) %></td></tr><% end %></tbody></table></div></section>
