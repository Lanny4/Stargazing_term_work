<% content_for :title, "Повідомлення — адмінпанель" %>
<section class="container section inner-page admin"><div class="eyebrow">ПОВІДОМЛЕННЯ</div><h1>Зворотний <em>зв’язок</em></h1><%= link_to "← Адмінпанель", admin_root_path, class: "text-link" %><div class="table-scroll"><table class="data-table"><thead><tr><th>Дата</th><th>Ім’я</th><th>Електронна пошта</th><th>Тема</th><th></th></tr></thead><tbody><% @messages.each do |message| %><tr><td><%= message.created_at.strftime("%d.%m.%Y") %></td><td><%= message.name %></td><td><%= message.email %></td><td><%= message.subject %></td><td><%= link_to "Читати", admin_contact_message_path(message) %></td></tr><% end %></tbody></table></div></section>
