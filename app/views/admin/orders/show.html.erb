<% content_for :title, "Замовлення ##{@order.id} — Stargazing" %>
<section class="container section inner-page admin"><div class="section-kicker">ДЕТАЛІ ЗАМОВЛЕННЯ</div><h1>Замовлення <em>#<%= @order.id %></em></h1><%= link_to "← Усі замовлення", admin_orders_path, class: "text-link" %>
<div class="checkout-layout"><div class="card-panel"><p><strong>Клієнт:</strong> <%= @order.customer_name %> (<%= @order.user.email %>)</p><p><strong>Телефон:</strong> <%= @order.phone %></p><p><strong>Адреса:</strong> <%= @order.city %>, <%= @order.address %></p><p><strong>Доставка:</strong> <%= Order::SHIPPING.fetch(@order.shipping_method).first %></p><p><strong>Оплата:</strong> <%= Order::PAYMENTS.fetch(@order.payment_method) %></p><p><strong>Статус:</strong> <%= display_status(@order.status) %></p><h2>Склад замовлення</h2><% @order.order_items.each do |item| %><div class="summary-row"><span><%= item.product_name %> × <%= item.quantity %></span><strong><%= money(item.total_cents) %></strong></div><% end %><div class="summary-total"><span>Разом</span><strong><%= money(@order.total_cents) %></strong></div></div>
<aside class="order-summary"><h3>Керування статусом</h3><p class="muted">Переведення у «Скасовано» повертає товари на склад один раз. Після скасування або відправлення статус більше не змінюється.</p>
<% allowed = Order::STATUS_TRANSITIONS.fetch(@order.status, []) %>
<% if allowed.any? %><%= form_with url: admin_order_path(@order), method: :patch do |f| %><div class="form-group"><%= f.label :status, "Новий статус" %><%= f.select :status, options_for_select(allowed.map { |status| [display_status(status), status] }), {}, class: "field" %></div><%= f.submit "Оновити статус", class: "btn btn-full", data: { turbo_confirm: "Підтвердити зміну статусу?" } %><% end %><% else %><p class="notice-small">Замовлення має фінальний статус.</p><% end %></aside></div></section>
