<% content_for :title, "Замовлення — адмінпанель" %>
<section class="container section inner-page admin"><div class="eyebrow">ЗАМОВЛЕННЯ</div><h1>Усі <em>замовлення</em></h1><%= link_to "← Адмінпанель", admin_root_path, class: "text-link" %><div class="table-scroll"><table class="data-table"><thead><tr><th>№</th><th>Дата</th><th>Користувач</th><th>Сума</th><th>Статус</th><th></th></tr></thead><tbody><% @orders.each do |order| %><tr><td>#<%= order.id %></td><td><%= order.created_at.strftime("%d.%m.%Y") %></td><td><%= order.user.name %></td><td><%= money(order.total_cents) %></td><td><%= display_status(order.status) %></td><td><%= link_to "Деталі", admin_order_path(order) %></td></tr><% end %></tbody></table></div></section>
