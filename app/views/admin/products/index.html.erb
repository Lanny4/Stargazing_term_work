<% content_for :title, "Товари — адмінпанель" %>
<section class="container section inner-page admin"><div class="section-head"><div><div class="eyebrow">АСОРТИМЕНТ</div><h1>Управління <em>товарами</em></h1></div><%= link_to "Додати товар +", new_admin_product_path, class: "btn" %></div><%= link_to "← Адмінпанель", admin_root_path, class: "text-link" %>
<div class="table-scroll"><table class="data-table"><thead><tr><th>Товар</th><th>Категорія</th><th>Ціна</th><th>Залишок</th><th>Активний</th><th>Дії</th></tr></thead><tbody><% @products.each do |product| %><tr><td><%= product.name %></td><td><%= product.category.name %></td><td><%= money(product.price_cents) %></td><td><%= product.stock %></td><td><%= product.active? ? "Так" : "Ні" %></td><td><%= link_to "Змінити", edit_admin_product_path(product), class: "text-link" %> · <%= button_to "Приховати", admin_product_path(product), method: :delete, class: "text-danger" if product.active? %></td></tr><% end %></tbody></table></div></section>
