<% content_for :title, "Замовлення ##{@order.id} — Stargazing" %>
<section class="container section inner-page"><div class="eyebrow">ПІДТВЕРДЖЕННЯ ЗАМОВЛЕННЯ</div><h1>Замовлення <em>#<%= @order.id %></em></h1><p class="muted">Оформлено <%= @order.created_at.strftime("%d.%m.%Y о %H:%M") %> · Статус: <strong><%= display_status(@order.status) %></strong></p>
<div class="checkout-layout"><div class="card-panel"><h2>Склад замовлення</h2><% @order.order_items.each do |item| %><div class="summary-row"><span><%= item.product_name %> × <%= item.quantity %></span><strong><%= money(item.total_cents) %></strong></div><% end %><hr><div class="summary-row"><span>Вартість товарів</span><strong><%= money(@order.subtotal_cents) %></strong></div><div class="summary-row"><span>Доставка</span><strong><%= money(@order.shipping_cents) %></strong></div><div class="summary-total"><span>Разом</span><strong><%= money(@order.total_cents) %></strong></div></div>
<aside class="order-summary"><h3>Доставка й оплата</h3><p><strong><%= @order.customer_name %></strong><br><%= @order.phone %><br><%= @order.city %>, <%= @order.address %></p><p>Доставка: <strong><%= Order::SHIPPING.fetch(@order.shipping_method).first %></strong></p><p>Оплата: <strong><%= Order::PAYMENTS.fetch(@order.payment_method) %></strong></p><% if !Rails.env.production? && @order.payment_method == "demo_card" && @order.status == "placed" %><p class="notice-small">Симулятор оплати. Жодних грошей не буде списано.</p><%= button_to "Підтвердити ДЕМО-оплату", pay_demo_order_path(@order), method: :post, class: "btn btn-full" %><% end %><%= link_to "Усі мої замовлення", orders_path, class: "continue-link" %></aside></div>
</section>
