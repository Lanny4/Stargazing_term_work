<% content_for :title, "Вхід — Stargazing" %>
<section class="auth-wrap container"><div class="auth-card"><div class="eyebrow">З ПОВЕРНЕННЯМ</div><h1>З поверненням <em>до себе</em></h1><p class="muted">Увійдіть, щоб переглядати свої замовлення та залишати відгуки.</p>
  <%= form_with url: session_path do |f| %>
    <div class="form-group"><%= f.label :email, "Електронна пошта" %><%= f.email_field :email, class: "field", required: true, autocomplete: "email" %></div>
    <div class="form-group"><%= f.label :password, "Пароль" %><%= f.password_field :password, class: "field", required: true, autocomplete: "current-password" %></div>
    <%= f.submit "Увійти", class: "btn btn-full" %>
  <% end %><p class="auth-bottom">Ще немає облікового запису? <%= link_to "Зареєструватися", new_registration_path %></p>
</div></section>
